# =============================================================================
# SmolVLA 추론 서버 (FastAPI, port 8000)
# -----------------------------------------------------------------------------
# 팀원이 작성한 원본 설정을 보존하면서, 빌드 안정성/캐시/헬스체크를 보강했습니다.
# 빌드:   docker compose build smolvla-server
# 실행:   docker compose up -d smolvla-server
# =============================================================================
FROM nvcr.io/nvidia/pytorch:25.01-py3

ENV DEBIAN_FRONTEND=noninteractive

# 1) 시스템 의존성 (원본 그대로 유지) + curl 추가 (헬스체크용)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# 2) LeRobot[smolvla] 본체 설치
#    - BuildKit 캐시 마운트로 재빌드 시 다운로드 시간 단축
#    - numpy==1.26.0 호스트 isaacsim 환경과 동일 핀 (1.23 / 2.x 모두 회피)
#    - 자동으로 끌고 오는 의존성: transformers, accelerate, huggingface_hub,
#      safetensors, datasets, einops, sentencepiece (별도 명시 X)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    "lerobot[smolvla] @ git+https://github.com/huggingface/lerobot.git" \
    "pillow==11.3.0" \
    "numpy==1.26.0" \
    "opencv-python-headless==4.11.0.86"

# 3) FastAPI 서빙 스택
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    "fastapi==0.115.7" \
    "uvicorn[standard]==0.29.0" \
    "pydantic==2.11.10"

# 4) 서버 코드 진입점 설정
#    빌드 시점에 이미지에 복사. compose 의 volumes 마운트가 있으면
#    그쪽이 우선합니다(개발 중 핫리로드 용이).
#    build context = docker/  →  docker/smolvla/serve_smolvla.py 를 가리킴.
WORKDIR /app
COPY smolvla/serve_smolvla.py .

# 5) 환경 변수 (원본 유지)
ENV MODEL_PATH=/models/vla-model
ENV DEVICE=cuda:0
ENV PORT=8000

EXPOSE 8000

# 6) 헬스체크 - compose 의 depends_on 조건부 시작에 활용
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=5 \
    CMD curl -fsS http://localhost:${PORT}/health || exit 1

CMD ["python", "serve_smolvla.py"]
