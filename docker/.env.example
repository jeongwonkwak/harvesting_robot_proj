# =============================================================================
# Strawberry Harvest 팀 - 개인별 환경 변수
# -----------------------------------------------------------------------------
# 사용법:
#   1) cp .env.example .env
#   2) 아래 값을 본인에 맞게 수정
#   3) docker compose --profile <원하는프로필> up -d
#
# 프로필 (docker compose --profile <이름> up -d):
#   sim   : Isaac Sim 만 (무거움, GPU 1개)
#   robot : 두산 에뮬레이터 만
#   dev   : ros2-lab + 두산 에뮬레이터  (YOLO/cuRobo/Quadtree 작업)
#   vla   : SmolVLA 추론 서버 만
#   all   : 4개 전부
# =============================================================================

# ---- [개인 식별] 컨테이너 이름 prefix ----------------------------------------
# 한 컴퓨터에서 여러 팀원이 동시에 띄울 때 본인 아이디로 충돌 방지.
# 예) USER_ID=jiwoo  →  jiwoo_ros2_lab, jiwoo_sim_engine ...
USER_ID=team1

# ---- [ROS2 DDS 도메인] ------------------------------------------------------
# 팀원 1: 1 / 팀원 2: 2 / 팀원 3: 3 / 팀원 4: 4
# 실로봇 통신 시에는 로봇 도메인(예: 66) 으로 변경
ROS_DOMAIN_ID=1

# ---- [GUI/NoVNC 자동 기동] --------------------------------------------------
# 0 = ros2-lab 진입 시 bash 만 띄움 (기본, 가벼움)
# 1 = NoVNC 8080 + Isaac WebRTC 뷰어 9000 자동 기동 (RViz 필요할 때만)
ENABLE_GUI=0
